# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ из Cursor Dashboard → API Keys.
# Если пусто, бот работает в демо-режиме: меню живое, агент Cursor не вызывается.
CURSOR_API_KEY=

# Числовые Telegram user id через запятую. Пусто — бот отвечает всем.
TELEGRAM_ALLOWED_USER_IDS=

# FORGE_DEMO=1 оставляет демо даже при заданном ключе.
FORGE_DEMO=

# Файл базы. По умолчанию data/bot.sqlite
DATABASE_PATH=
